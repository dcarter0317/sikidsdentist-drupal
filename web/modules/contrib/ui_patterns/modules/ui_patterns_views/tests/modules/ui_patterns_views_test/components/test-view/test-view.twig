<div{{ attributes.addClass('test-view') }}>
  <h2 class="test-view__title">{{ title }}</h2>
  <div class="test-view__header">{{ header }}</div>
  <div class="test-view__exposed">{{ exposed }}</div>
  <div class="test-view__attachment-before">{{ attachment_before }}</div>
  <div class="test-view__rows">{{ rows }}</div>
  <div class="test-view__empty">{{ empty }}</div>
  <div class="test-view__pager">{{ pager }}</div>
  <div class="test-view__attachment-after">{{ attachment_after }}</div>
  <div class="test-view__more">{{ more }}</div>
  <div class="test-view__footer">{{ footer }}</div>
  <div class="test-view__feed-icons">{{ feed_icons }}</div>
</div>
