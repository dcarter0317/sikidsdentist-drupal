<?php

/**
 * @file
 * UI Patterns Views module.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ui_patterns_views\Hook\UiPatternsViewsHooks;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_post_render().
 */
#[LegacyHook]
function ui_patterns_views_views_post_render(ViewExecutable $view, array &$output): void {
  Drupal::service(UiPatternsViewsHooks::class)->viewsPostRender($view, $output);
}

/**
 * Implements hook_config_schema_info_alter().
 */
#[LegacyHook]
function ui_patterns_views_config_schema_info_alter(array &$definitions): void {
  Drupal::service(UiPatternsViewsHooks::class)->configSchemaInfoAlter($definitions);
}

/**
 * Implements hook_ajax_render_alter().
 */
#[LegacyHook]
function ui_patterns_views_ajax_render_alter(array &$data): void {
  Drupal::service(UiPatternsViewsHooks::class)->ajaxRenderAlter($data);
}
