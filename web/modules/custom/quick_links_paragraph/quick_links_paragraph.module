<?php

/**
 * @file
 * quick_links_paragraph.module
 *
 * Integrates the Quick Links paragraph bundles with the Quick Links SDC component.
 */

/**
 * Implements hook_theme().
 */
function quick_links_paragraph_theme(): array {
  return [
    'paragraph__quick_links' => [
      'base hook' => 'paragraph',
    ],
    'paragraph__quick_link_item' => [
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 */
function quick_links_paragraph_theme_suggestions_paragraph_alter(
  array &$suggestions,
  array $variables
): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['elements']['#paragraph'];
  $bundle = $paragraph->bundle();
  $suggestions[] = 'paragraph__' . $bundle;
}
