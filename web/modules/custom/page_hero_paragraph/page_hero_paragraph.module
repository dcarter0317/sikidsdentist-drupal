<?php

/**
 * @file
 * page_hero_paragraph.module
 *
 * Integrates the Page Hero paragraph bundle with the Page Hero SDC component.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_theme().
 *
 * Registers the paragraph__page_hero theme hook so Drupal resolves
 * the paragraph--page-hero.html.twig bridge template automatically.
 */
function page_hero_paragraph_theme(): array {
  return [
    'paragraph__page_hero' => [
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 */
function page_hero_paragraph_theme_suggestions_paragraph_alter(
  array &$suggestions,
  array $variables
): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['elements']['#paragraph'];
  $bundle = $paragraph->bundle();
  $suggestions[] = 'paragraph__' . $bundle;
}
