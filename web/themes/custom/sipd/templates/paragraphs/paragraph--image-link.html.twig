{#
/**
 * @file paragraph--image-link.html.twig
 *
 * Bridge template for the "Image Link" paragraph bundle.
 * Maps Paragraph field values to the Image Link SDC props.
 */
#}

<div{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {%- set url = null -%}
{%- set text = null -%}
{%- set image = null -%}
{%- set image_alt = null -%}

{# Extract Link Destination URL & Text #}
{% if paragraph.field_image_link_url is defined and paragraph.field_image_link_url.0 %}
  {%- set url = paragraph.field_image_link_url.0.url.toString -%}
  {%- set text = paragraph.field_image_link_url.0.title|default(null) -%}
{% endif %}

{# Extract Text Override if provided #}
{% if paragraph.field_image_link_text is defined and not paragraph.field_image_link_text.isEmpty %}
  {%- set text = paragraph.field_image_link_text.value -%}
{% endif %}

{# Extract Background Image Media #}
{% if paragraph.field_image_link_media is defined and paragraph.field_image_link_media.entity %}
  {%- set _media = paragraph.field_image_link_media.entity -%}
  {% if _media.field_media_image is defined and _media.field_media_image.entity %}
    {%- set image = _media.field_media_image.entity.uri.value|file_url -%}
    {%- set image_alt = _media.field_media_image.alt|default('') -%}
  {% endif %}
{% endif %}

{# Extract Background Color & Opacity #}
{%- set bg_color = null -%}
{%- set bg_opacity = null -%}
{% if paragraph.field_image_link_bg_color is defined and not paragraph.field_image_link_bg_color.isEmpty %}
  {%- set bg_color = paragraph.field_image_link_bg_color.color -%}
  {%- set bg_opacity = paragraph.field_image_link_bg_color.opacity -%}
  {% if bg_color and bg_color|first != '#' %}
    {%- set bg_color = '#' ~ bg_color -%}
  {% endif %}
{% endif %}

{% if url and image %}
  {% include 'sipd:image-link' with {
    url: url,
    text: text,
    image: image,
    image_alt: image_alt,
    bg_color: bg_color,
    bg_opacity: bg_opacity
  } only %}
{% endif %}
</div>