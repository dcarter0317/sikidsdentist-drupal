<div{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {%- set title = paragraph.field_tb_title.value -%}
  {# Body: use .processed to get the text-format-filtered HTML #}
  {%- set body = paragraph.field_tb_body.processed -%}
  {%- set text_align = paragraph.field_tb_text_align.value|default('left') -%}

  {%- set dark_mode = paragraph.field_tb_dark_mode.value ? true : false -%}
  {%- set bg_color = null -%}
  {% if paragraph.field_tb_bg_color is defined and not paragraph.field_tb_bg_color.isEmpty %}
    {%- set bg_color = paragraph.field_tb_bg_color.0.color -%}
    {% if bg_color and bg_color|first != '#' %}
      {%- set bg_color = '#' ~ bg_color -%}
    {% endif %}
  {% endif %}
  {%- set text_color = null -%}
  {% if paragraph.field_tb_text_color is defined and not paragraph.field_tb_text_color.isEmpty %}
    {%- set text_color = paragraph.field_tb_text_color.0.color -%}
    {% if text_color and text_color|first != '#' %}
      {%- set text_color = '#' ~ text_color -%}
    {% endif %}
  {% endif %}

{% include "sipd:text-block" with {
  title:           title,
  body:            body,
  text_align:      text_align,
  dark_mode:       dark_mode,
  bg_color:        bg_color,
  text_color:      text_color
} only %}
</div>