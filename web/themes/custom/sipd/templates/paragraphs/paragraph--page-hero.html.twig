{#
/**
 * @file paragraph--page-hero.html.twig
 *
 * Paragraph template for the 'page_hero' bundle.
 * Maps field values from the paragraph entity to the page-hero SDC props.
 *
 * Fields:
 *   - field_ph_banner_label  Text (plain)
 *   - field_ph_title         Text (plain)
 *   - field_ph_description   Text (formatted, long)
 *   - field_ph_cta           Link
 *   - field_ph_image         Entity reference (Media)
 */
#}

{# ── Plain text fields ── #}
{%- set banner_label = paragraph.field_ph_banner_label.value -%}
{%- set title = paragraph.field_ph_title.value -%}

{# Formatted text — use .processed to get filtered HTML output #}
{%- set description = paragraph.field_ph_description.processed -%}

{# CTA link field #}
{%- set cta_label = paragraph.field_ph_cta.title -%}
{%- set cta_url = null -%}
{%- if paragraph.field_ph_cta.0 -%}
  {%- set cta_url = paragraph.field_ph_cta.0.url.toString() -%}
{%- endif -%}


{# Media entity reference — traverse to the file entity for URL and alt text #}
{%- set image_url = null -%}
{%- set image_alt = '' -%}
{%- if paragraph.field_ph_image.entity -%}
  {%- set media_entity = paragraph.field_ph_image.entity -%}
  {%- set file_entity = media_entity.field_media_image.entity -%}
  {%- set image_url = file_entity ? file_url(file_entity.uri.value) : null -%}
  {%- set image_alt = media_entity.field_media_image.alt|default('') -%}
{%- endif -%}

{% include 'sipd:page-hero' with {
  banner_label: banner_label,
  title: title,
  description: description,
  cta_label: cta_label,
  cta_url: cta_url,
  image_url: image_url,
  image_alt: image_alt,
} only %}
