{#
/**
 * @file paragraph--floated-content.html.twig
 *
 * Bridge template: maps 'floated_content' paragraph fields → Floated Content SDC props.
 * Located in: web/themes/custom/sipd/templates/paragraphs/
 */
#}

{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {%- set float_direction = paragraph.field_fc_float_direction[0].value|default('left')|lower -%}

{# Body: use .processed to get the text-format-filtered HTML #}
{%- set body = paragraph.field_fc_body.processed -%}

{# Image via Media entity reference → field_media_image → File entity → URL #}
{%- set media_entity = paragraph.field_fc_image.entity -%}
{%- set image_file   = media_entity ? media_entity.field_media_image.entity : null -%}
{%- set image_url    = image_file ? file_url(image_file.uri.value) : null -%}
{%- set image_alt    = media_entity ? media_entity.field_media_image.alt : null -%}

{%- set dark_mode = paragraph.field_fc_dark_mode.value ? true : false -%}
{%- set bg_color = null -%}
{% if paragraph.field_fc_bg_color is defined and not paragraph.field_fc_bg_color.isEmpty %}
  {%- set bg_color = paragraph.field_fc_bg_color.0.color -%}
  {% if bg_color and bg_color|first != '#' %}
    {%- set bg_color = '#' ~ bg_color -%}
  {% endif %}
{% endif %}
{%- set text_color = null -%}
{% if paragraph.field_fc_text_color is defined and not paragraph.field_fc_text_color.isEmpty %}
  {%- set text_color = paragraph.field_fc_text_color.0.color -%}
  {% if text_color and text_color|first != '#' %}
    {%- set text_color = '#' ~ text_color -%}
  {% endif %}
{% endif %}

{% include "sipd:floated-content" with {
  float_direction: float_direction,
  body:            body,
  image_url:       image_url,
  image_alt:       image_alt,
  dark_mode:       dark_mode,
  bg_color:        bg_color,
  text_color:      text_color
} only %}
</div>