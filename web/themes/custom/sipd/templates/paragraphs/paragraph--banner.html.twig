{#
  paragraph--banner.html.twig
  Maps 'banner' paragraph fields to the sipd:banner SDC component.
#}

<div{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {%- set banner_style = paragraph.field_banner_style.value|default('default')|replace({'_': '-'}) -%}
{%- set title        = paragraph.field_banner_title.value -%}
{%- set eyebrow      = paragraph.field_eyebrow.value -%}
{%- set cta_label    = paragraph.field_primary_cta.title -%}
{%- set cta_url      = paragraph.field_primary_cta.uri -%}
{%- set cta_secondary_label = paragraph.field_secondary_cta.title -%}
{%- set cta_secondary_url   = paragraph.field_secondary_cta.uri -%}

{%- set props = {
  banner_style:        banner_style,
  title:               title,
  eyebrow:             eyebrow,
  cta_label:           cta_label,
  cta_url:             cta_url,
  cta_secondary_label: cta_secondary_label,
  cta_secondary_url:   cta_secondary_url,
} -%}

{%- set raw_anim = paragraph.field_banner_animation_style.value -%}
{%- if raw_anim -%}
  {%- set props = props|merge({animation_class: raw_anim|replace({'ban_': '', '_': '-'})}) -%}
{%- endif -%}

{% include "sipd:banner" with props only %}
</div>