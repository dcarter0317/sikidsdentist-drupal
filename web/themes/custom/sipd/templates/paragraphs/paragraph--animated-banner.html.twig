{#
  paragraph--animated-banner.html.twig
  Maps 'animated_banner' paragraph fields to the sipd:animated-banner SDC component.
#}

<div{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {%- set banner_style = paragraph.field_ab_style.value|default('default')|replace({'ab_': '', '_': '-'}) -%}
{%- set title        = paragraph.field_ab_title.value -%}
{%- set body         = paragraph.field_ab_body.value -%}
{%- set eyebrow      = paragraph.field_ab_eyebrow.value -%}
{%- set cta_label    = paragraph.field_ab_cta.0.title|default(null) -%}
{%- set cta_url      = paragraph.field_ab_cta.0 ? paragraph.field_ab_cta.0.url.toString() : null -%}
{%- set cta_secondary_label = paragraph.field_ab_cta_secondary.0.title|default(null) -%}
{%- set cta_secondary_url   = paragraph.field_ab_cta_secondary.0 ? paragraph.field_ab_cta_secondary.0.url.toString() : null -%}
{%- set cta_layout   = paragraph.field_cta_layout.value|default('row') -%}

{%- set props = {
  banner_style:        banner_style,
  title:               title,
  body:                body,
  eyebrow:             eyebrow,
  cta_label:           cta_label,
  cta_url:             cta_url,
  cta_secondary_label: cta_secondary_label,
  cta_secondary_url:   cta_secondary_url,
  cta_layout:          cta_layout,
} -%}

{%- set raw_anim = paragraph.field_animation_style.value -%}
{%- if raw_anim -%}
  {%- set props = props|merge({animation_class: raw_anim|replace({'_': '-'})}) -%}
{%- endif -%}

{% include "sipd:animated-banner" with props only %}
</div>