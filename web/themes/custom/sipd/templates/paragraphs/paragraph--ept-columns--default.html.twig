{#
/**
 * @file paragraph--ept-columns--default.html.twig
 *
 * Theme override for the EPT Columns paragraph.
 * Reads layout settings from `content['#object']` using the robust
 * field property retrieval chain to ensure correct class assignment.
 */
#}
{{ attach_library('ept_columns/ept_columns') }}

{%
  set ept = content.field_ept_settings['#object'].field_ept_settings.ept_settings
%}

{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    'ept-paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'ept-paragraph',
    'ept-paragraph-columns',
    'paragraph-id-' ~ paragraph.id(),
  ]
%}

{% if ept.layout %}
  {% set classes = classes|merge(['column-' ~ ept.layout]) %}
{% endif %}

{% if ept.column_width_two %}
  {% set classes = classes|merge(['columns-' ~ ept.column_width_two]) %}
{% endif %}

{% if ept.column_width_three %}
  {% set classes = classes|merge(['columns-' ~ ept.column_width_three]) %}
{% endif %}

{% if ept.column_width_four %}
  {% set classes = classes|merge(['columns-' ~ ept.column_width_four]) %}
{% endif %}

{% if ept.equal_height %}
  {% set classes = classes|merge(['columns-equal-height']) %}
{% endif %}

{% if ept.full_bleed or ept.full_bleed_bg %}
  {% set classes = classes|merge(['columns-full-bleed']) %}
{% endif %}

{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {{ title_prefix }}
    {{ title_suffix }}
    <div class="bg-inner"></div>
    <div class="ept-container{{ ept.full_bleed_bg ? ' content-container' }}">
      {% block content %}
        {% if content.field_ept_title|render %}
          {% set wrapper = ept.title_options.title_wrapper|default('h2') %}
          {% if wrapper != 'none' %}
            <{{ wrapper in ['h1','h2','h3','h4','h5'] ? wrapper : 'h2' }}>
          {% endif %}
          {% if ept.title_options.strip_tags %}
            {{ content.field_ept_title|render|striptags('<span><br><i><img><svg>')|trim|raw }}
          {% else %}
            {{ content.field_ept_title }}
          {% endif %}
          {% if wrapper != 'none' %}
            </{{ wrapper in ['h1','h2','h3','h4','h5'] ? wrapper : 'h2' }}>
          {% endif %}
        {% endif %}
        {{ content|without('field_ept_settings', 'field_ept_title') }}
      {% endblock %}
    </div>
  </div>
{% endblock paragraph %}
{{ styles|raw }}
