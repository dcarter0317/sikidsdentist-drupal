{{ attach_library('sipd/global') }}
{% set classes = [
  'page-wrap'
] %}
<section {{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% include('@sipd/templates/layout/header.html.twig') %}

  <!-- INTERIOR HERO SECTION -->
  <section class="interior-hero-section">
      <div class="content-container flex-content">
          <div class="content-primary">
              <img src="{{ base_path ~ directory }}/assets/imgs/sipd_logo.svg" alt="Staten Island Pediatric Dentistry Logo" class="logo">
          </div>
          <div class="content-secondary">
              <button class="btn btn--primary">contact us</button>
              <div><a href="https://maps.google.com/maps?f=q&source=s_q&hl=en&geocode=&q=195+Bridgetown+Street+Staten+Island+NY+10314">195 Bridgetown St, Staten Island, NY</a></div>
              <div><a href="tel:+17187617316">(718) 761-7316</a></div>
              <ul class="social-links">
                  <li><a class="facebook" target="_blank" rel="noopener noreferrer" aria-label="Staten Island Pediatric Dentistry on Facebook" href="https://www.facebook.com/StatenIslandPediatricDentistry/"><i class="fa-brands fa-facebook"></i></a></li>
                  <li><a class="googleplus" target="_blank" rel="noopener noreferrer" aria-label="Search results for Staten Island Pediatric Dentistry on Google" href="https://www.google.com/search?q=Staten+Island+Pediatric+Dentistry&amp;oq=Staten+Island+Pediatric+Dentistry&amp;aqs=chrome..69i57j69i61l3&amp;sourceid=chrome&amp;ie=UTF-8#lrd=0x89c24c77b5a2a0c5:0xb12cee23ab937623,1,,,"><i class="fa-brands fa-google"></i></a></li>
                  <li><a class="instagram" target="_blank" rel="noopener noreferrer" aria-label="Staten Island Pediatric Dentistry on Instagram" href="https://www.instagram.com/si_pediatric_dentistry/#"><i class="fa-brands fa-instagram"></i></a></li>
              </ul>
          </div>
          <div class="content-secondary-mobile">
              <div class="phone-number mobile-btn-v2 visible-xs">
                  <a href="tel:7187617316" onclick="gdw.recordCall('7187617316');">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24.638" height="24.638" viewBox="0 0 24.638 24.638">
