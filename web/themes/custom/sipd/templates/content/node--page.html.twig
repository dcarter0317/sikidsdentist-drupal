                  <a class="gpw-booking" href="/contact">
                      <svg xmlns="http://www.w3.org/2000/svg" width="27.052" height="26.991" viewBox="0 0 27.052 26.991">
                          <g id="Group_11" data-name="Group 11" transform="translate(-10 -9.9)">
                              <path id="Path_20" data-name="Path 20" d="M34.237,38.055H12.693A2.717,2.717,0,0,1,10,35.362V15.593A2.5,2.5,0,0,1,12.265,12.9h1.346v1.775H12.265c-.184,0-.428.367-.428.918V35.362a.941.941,0,0,0,.918.918H34.3a.941.941,0,0,0,.918-.918V15.593c0-.551-.306-.918-.428-.918H33.441V12.9h1.346a2.537,2.537,0,0,1,2.265,2.693V35.362a2.913,2.913,0,0,1-2.815,2.693" transform="translate(0 -1.164)" fill="#fff"></path>
