{#
/**
 * @file animated-banner.twig
 *
 * Animated Banner SDC with animation support.
 * Animation class is applied to banner__content div.
 *
 * Available props (defined in animated-banner.component.yml):
 *   - animation_class (string) - animation class e.g. slide-in-content-left
 *   - banner_style (string)   - 'default' | 'button-banner' | 'cta-banner'
 *   - title (string)
 *   - body (string)
 *   - eyebrow (string)
 *   - cta_label (string)
 *   - cta_url (string)
 *   - cta_secondary_label (string)
 *   - cta_secondary_url (string)
 */
#}

{%- set banner_style = banner_style|default('default') -%}
{%- set content_classes = ['banner__content', 'banner--' ~ banner_style] -%}
{%- if animation_class -%}
  {%- set content_classes = content_classes|merge([animation_class]) -%}
{%- endif -%}

<article class="banner">
  <div class="{{ content_classes|join(' ') }}">

    {% if banner_style == 'button-banner' %}

      {% if eyebrow %}
        <p class="banner__eyebrow">{{ eyebrow }}</p>
      {% endif %}

      {% if title %}
        <h2 class="banner__title">{{ title }}</h2>
      {% endif %}

      <div class="banner__btn-group">
        {% if cta_label and cta_url %}
          <a href="{{ cta_url }}" class="banner__btn">{{ cta_label }}</a>
        {% endif %}
        {% if cta_secondary_label and cta_secondary_url %}
          <a href="{{ cta_secondary_url }}" class="banner__btn">{{ cta_secondary_label }}</a>
        {% endif %}
      </div>

    {% elseif banner_style == 'cta-banner' %}

      {% if title %}
        <p class="p-title">{{ title }}</p>
      {% endif %}

      {% if cta_label and cta_url %}
        <a href="{{ cta_url }}" class="banner__btn">
          {{ cta_label }}
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      {% endif %}

    {% else %}

      {% if title %}
        <h2 class="banner__title">{{ title }}</h2>
      {% endif %}

    {% endif %}

  </div>
</article>
