{#
 * Available variables:
 *   - title (string)
 *   - date (string)
 *   - author (string)
 *   - author_link (string)
 *   - background_image_url (string)
 *   - background_image_alt (string)
 *   - content_alignment (string) - 'centered' | 'content-left' | 'content-right'
#}

<div class="blog-hero blog-hero--{{ content_alignment|default('centered') }}">
     <div class="blog-hero__background" aria-hidden="true">
        <img src="{{ background_image_url }}" alt="{{ background_image_alt|default('') }}" loading="eager" fetchpriority="high">
     </div>   
    <div class="blog-hero__content">
        <h1 class="blog-hero__title" aria-label="{{ title }}">{{ title }}</h1>
        <div class="blog-hero__info">
            <p class="blog-hero__date" aria-label="{{ date }}">{{ date }}</p>
            <p class="blog-hero__divider">&verbar;</p>
            <p>Posted By: <a class="blog-hero__author" href="{{ author_link }}">{{ author }}</a></p>
        </div>
    </div>
</div>