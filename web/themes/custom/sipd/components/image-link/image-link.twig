{#
/**
 * @file image-link.twig
 *
 * Image Link Single Directory Component.
 *
 * Props:
 * - url (string) — link destination URL
 * - text (string) — link text displayed on top of the image overlay
 * - image (string) — background image source URL
 * - image_alt (string) — alt text for the background image
 */
#}
{% set inline_styles = [] %}
{% if bg_color %}
  {% set inline_styles = inline_styles|merge(['--image-link-bg-color: ' ~ bg_color]) %}
{% endif %}
{% if bg_opacity %}
  {% set inline_styles = inline_styles|merge(['--image-link-bg-opacity: ' ~ bg_opacity]) %}
{% endif %}
{% set style_str = inline_styles|length > 0 ? inline_styles|join('; ') ~ ';' : '' %}

<div class="image-link"{% if style_str %} style="{{ style_str }}"{% endif %}>
  <a href="{{ url }}" class="image-link__link">
    <div class="image-link__image-wrapper">
      {% if image %}
        <img src="{{ image }}" alt="{{ image_alt }}" class="image-link__image">
      {% endif %}
    </div>
    {% if text %}
      <h2 class="image-link__text">{{ text }}</h2>
    {% endif %}
  </a>
</div>
