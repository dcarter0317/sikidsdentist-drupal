{#
/**
 * @file card.twig
 *
 * Card Single Directory Component.
 *
 * Props:
 * - eyebrow
 * - title
 * - description
 * - image
 * - image_alt
 * - cta_label
 * - cta_url
 */
#}

{%
  set card_classes = [
    'card',
    variant_class|default(''),
    type_class|default(''),
  ]
%}

<article class="{{ card_classes|join(' ')|trim }}">
  {% if image %}
    <div class="card__media">
      <img src="{{ image }}" alt="{{ image_alt|default('') }}">
    </div>
  {% endif %}

  <div class="card__content">
    {% if eyebrow %}
      <p class="card__eyebrow">{{ eyebrow }}</p>
    {% endif %}

    {% if title %}
      <h3 class="card__title">{{ title }}</h3>
    {% endif %}

    {% if description %}
      <div class="card__description">{{ description }}</div>
    {% endif %}

    {% if cta_label and cta_url %}
      <a class="card__link" href="{{ cta_url }}">
        {{ cta_label }}
      </a>
    {% endif %}
  </div>
</article>
