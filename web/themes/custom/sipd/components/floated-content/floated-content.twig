{#
/**
 * @file floated-content.twig
 *
 * Floated Content Single Directory Component (SDC).
 *
 * Available props (defined in floated-content.component.yml):
 *   - image_url (string) - URL of the floated image
 *   - image_alt (string) - alt text for the image
 *   - body (string, required) - pre-rendered HTML body copy
 *   - float_direction (string) - 'left' | 'right', defaults to 'left'
 */
#}

{%- set direction = float_direction|default('left')|trim|lower -%}
{%- set direction = direction in ['left', 'right'] ? direction : 'right' -%}
{%- set dark_mode_class = dark_mode ? 'floated-content--dark' : '' -%}

{% set inline_styles = [] %}
{% if dark_mode and bg_color %}
  {% set inline_styles = inline_styles|merge(['--floated-content-bg: ' ~ bg_color]) %}
{% endif %}
{% if dark_mode and text_color %}
  {% set inline_styles = inline_styles|merge(['--floated-content-color: ' ~ text_color]) %}
{% endif %}
{% set style_str = inline_styles|length > 0 ? inline_styles|join('; ') ~ ';' : '' %}
{% set style_attribute = style_str ? 'style="' ~ style_str ~ '"' : '' %}

<div class="floated-content {{ dark_mode_class }}" {{ style_attribute|raw }}>

  {% if image_url %}
    <div class="floated-content__image floated-content__image--{{ direction }}">
      <img
        src="{{ image_url }}"
        alt="{{ image_alt|default('') }}"
        class="floated-content__img"
        loading="lazy"
      />
    </div>
  {% endif %}

  <div class="floated-content__body">
    {{ body|raw }}
  </div>

</div>