{#
/**
 * @file hero.twig
 *
 * Hero Single Directory Component (SDC).
 *
 * Available props (defined in hero.component.yml):
 *   - headline (string, required)
 *   - subheadline (string)
 *   - body (string)
 *   - cta_label (string)
 *   - cta_url (string)
 *   - background_image_url (string)
 *   - background_image_alt (string)
 *   - theme (string) - 'light' | 'dark'
 *
 * Available slots:
 *   - media (rendered media entity)
 */
#}

{%
  set theme_class = theme == 'light' ? 'hero--light' : 'hero--dark'
%}

<section
  class="hero {{ theme_class }}{{ variant_class ? ' ' ~ variant_class : '' }}"
  aria-label="{{ headline }}"
  {% if background_image_url %}
    style="--hero-bg-image: url('{{ background_image_url }}');"
  {% endif %}
>

  {# Background image layer — rendered as a presentational img for better LCP performance #}
  {% if background_image_url %}
    <div class="hero__background" aria-hidden="true">
      <img
        src="{{ background_image_url }}"
        alt="{{ background_image_alt|default('') }}"
        class="hero__background-img"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  {% endif %}

  {# Overlay for contrast #}
  <div class="hero__overlay" aria-hidden="true"></div>

  {# Main content container #}
  <div class="hero__inner">
    <div class="hero__content">

      {% if subheadline %}
        <p class="hero__subheadline">{{ subheadline }}</p>
      {% endif %}

      <h1 class="hero__headline">{{ headline }}</h1>

      {% if body %}
        <div class="hero__body">
          <p>{{ body }}</p>
        </div>
      {% endif %}

      {% if cta_label and cta_url %}
        <div class="hero__cta-wrapper">
          <a
            href="{{ cta_url }}"
            class="hero__cta"
            {% if cta_url starts with 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            <span class="hero__cta-label">{{ cta_label }}</span>
            <span class="hero__cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      {% endif %}

    </div>{# /.hero__content #}

    {# Optional media slot — rendered entity from Paragraphs media field #}
    {% if media %}
      <div class="hero__media">
        {{ media }}
      </div>
    {% endif %}

  </div>{# /.hero__inner #}

</section>{# /.hero #}