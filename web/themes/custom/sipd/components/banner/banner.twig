{#
  banner.twig
  Props: banner_style, title, body, eyebrow, cta_label, cta_url,
         cta_secondary_label, cta_secondary_url, animation_class
#}

{%- set banner_style = banner_style|default('default') -%}
{%- set article_classes = ['banner', 'banner--' ~ banner_style] -%}
{%- if animation_class -%}
  {%- set article_classes = article_classes|merge([animation_class]) -%}
{%- endif -%}

<article class="{{ article_classes|join(' ') }}">
  <div class="banner__content">

    {% if banner_style == 'button-banner' %}

      {% if eyebrow %}
        <p class="banner__eyebrow">{{ eyebrow }}</p>
      {% endif %}

      {% if title %}
        <h2 class="banner__title">{{ title }}</h2>
      {% endif %}

      <div class="banner__btn-group">
        {% if cta_label and cta_url %}
          <a href="{{ cta_url }}" class="banner__btn">{{ cta_label }}</a>
        {% endif %}
        {% if cta_secondary_label and cta_secondary_url %}
          <a href="{{ cta_secondary_url }}" class="banner__btn">{{ cta_secondary_label }}</a>
        {% endif %}
      </div>

    {% elseif banner_style == 'cta-banner' %}

      {% if title %}
        <p class="p-title">{{ title }}</p>
      {% endif %}

      {% if cta_label and cta_url %}
        <a href="{{ cta_url }}" class="banner__btn">
          {{ cta_label }}
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      {% endif %}

    {% else %}

      {% if title %}
        <h2 class="banner__title">{{ title }}</h2>
      {% endif %}

    {% endif %}

  </div>
</article>