{#
/**
 * @file table.twig
 *
 * Table Single Directory Component.
 *
 * Props:
 * - caption
 * - headers
 * - rows
 * - variant_class
 * - dark_mode
 * - vertical_borders
 * - outer_border
 * - bg_color
 * - header_bg_color
 * - row_bg_color
 * - col_bg_color
 * - mobile_layout ("scroll" [default] or "stacked")
 */
#}

{% set mobile_layout = mobile_layout|default('scroll') %}
{% set is_stacked = mobile_layout == 'stacked' %}

{%
  set wrap_classes = [
    'table-wrap',
    dark_mode ? 'table-wrap--dark' : '',
  ]
%}

{%
  set table_classes = [
    'table-comp',
    variant_class|default(''),
    dark_mode ? 'table-comp--dark' : '',
    vertical_borders ? 'table-comp--vertical-borders' : '',
    outer_border ? 'table-comp--outer-border' : '',
    is_stacked ? 'table-comp--stacked' : '',
  ]
%}

{% set inline_styles = [] %}
{% if bg_color %}
  {% set inline_styles = inline_styles|merge(['--table-bg: ' ~ bg_color]) %}
{% endif %}
{% if header_bg_color %}
  {% set inline_styles = inline_styles|merge(['--table-header-bg: ' ~ header_bg_color]) %}
{% endif %}
{% if row_bg_color %}
  {% set inline_styles = inline_styles|merge(['--table-row-bg: ' ~ row_bg_color]) %}
{% endif %}
{% if col_bg_color %}
  {% set inline_styles = inline_styles|merge(['--table-col-bg: ' ~ col_bg_color]) %}
{% endif %}
{% set style_str = inline_styles|length > 0 ? inline_styles|join('; ') ~ ';' : '' %}
{% set style_attribute = style_str ? 'style="' ~ style_str ~ '"' : '' %}

{#
  When the table can scroll horizontally, expose it as a keyboard-focusable
  region (WCAG 1.4.10 / 2.1.1) so keyboard-only users can scroll it without
  a mouse or touch input.
#}
{% set scroll_a11y_attributes = is_stacked ? '' : ('role="region" tabindex="0" aria-label="' ~ (caption|default('Scrollable data table')) ~ '"') %}

<div class="{{ wrap_classes|join(' ')|trim }}" {{ style_attribute|raw }} {{ scroll_a11y_attributes|raw }}>
  <table class="{{ table_classes|join(' ')|trim }}">
    {% if caption %}
      <caption>{{ caption }}</caption>
    {% endif %}

    {% if headers %}
      <thead>
        <tr>
          {% for heading in headers %}
            <th scope="col">{{ heading }}</th>
          {% endfor %}
        </tr>
      </thead>
    {% endif %}

    {% if rows %}
      <tbody>
        {% for row in rows %}
          <tr>
            {% if row.heading %}
              <th scope="row">{{ row.heading }}</th>
            {% endif %}
            {% set header_offset = row.heading ? 1 : 0 %}
            {% for cell in row.cells %}
              {# data-label powers the stacked mobile layout's "label: value" rows.
                 Offset by 1 when a row heading is present, since the first
                 header column belongs to the <th>, not the first <td>. #}
              <td data-label="{{ headers[loop.index0 + header_offset]|default('') }}">{{ cell }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    {% endif %}
  </table>
</div>
