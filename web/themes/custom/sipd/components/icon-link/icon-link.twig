{#
/**
 * @file icon-link.twig
 *
 * Icon Link Single Directory Component.
 *
 * Props:
 * - url (string) — link destination
 * - text (string) — link text displayed
 * - icon_class (string) — Font Awesome icon class (optional, default: fa-solid fa-user-group)
 */
#}

<div class="icon-link">
  <a href="{{ url }}" class="icon-link__link">
    <span class="icon-link__icon" aria-hidden="true">
      <i class="{{ icon_class|default('fa-solid fa-user-group') }}"></i>
    </span>

    <span class="icon-link__text">
      {{ text }}
    </span>
  </a>
</div>