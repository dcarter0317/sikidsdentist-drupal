<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the sipd theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function sipd_preprocess_html(array &$variables): void {

}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function sipd_preprocess_page(array &$variables): void {

}

/**
 * Implements hook_preprocess_page__front() for page--front.html.twig.
 *
 * Reads theme settings and exposes them as variables to main-section.html.twig.
 */
function sipd_preprocess_page__front(array &$variables): void {
  $theme_path = '/' . \Drupal::service('extension.list.theme')->getPath('sipd');

  // ── Hero Section ────────────────────────────────────────────────────────
  $variables['hero_show_overlay']     = (bool) (theme_get_setting('hero_show_overlay') ?? TRUE);
  $variables['hero_contact_btn_text'] = theme_get_setting('hero_contact_btn_text') ?: 'contact us';
  $variables['hero_contact_btn_url']  = theme_get_setting('hero_contact_btn_url') ?: '/contact';
  $variables['hero_address_text']     = theme_get_setting('hero_address_text') ?: '195 Bridgetown St, Staten Island, NY';
  $variables['hero_address_url']      = theme_get_setting('hero_address_url') ?: 'https://maps.google.com/maps?f=q&source=s_q&hl=en&geocode=&q=195+Bridgetown+Street+Staten+Island+NY+10314';
  $variables['hero_phone_text']       = theme_get_setting('hero_phone_text') ?: '(718) 761-7316';
  $variables['hero_phone_number']     = theme_get_setting('hero_phone_number') ?: '7187617316';
  $variables['hero_booking_url']      = theme_get_setting('hero_booking_url') ?: '/contact';
  $variables['hero_heading']          = theme_get_setting('hero_heading') ?: 'Providing optimum dental care to your child in a friendly environment.';
  $variables['hero_cta_text']         = theme_get_setting('hero_cta_text') ?: 'about our practice';
  $variables['hero_cta_url']          = theme_get_setting('hero_cta_url') ?: '/about-us';

  // ── Featured Section ─────────────────────────────────────────────────────
  $featured_bg = theme_get_setting('featured_bg_image') ?: '';
  $variables['featured_bg_style'] = $featured_bg ? 'background-image: url(' . $featured_bg . ');' : '';
  $variables['featured_heading']   = theme_get_setting('featured_heading') ?: 'Welcome to Staten Island Pediatric Dentistry';
  $variables['featured_body_1']    = theme_get_setting('featured_body_1') ?: 'Your child is precious to you, and they are precious to us too. It takes a special group of people to work exclusively with children, and that is exactly what you\'ll find at Staten Island Pediatric Dentistry.';
  $variables['featured_body_2']    = theme_get_setting('featured_body_2') ?: 'Many of us are parents too, and we know the level of trust required to put your child\'s care in anyone\'s hands but your own. Starting with your child\'s first interaction with our dental team, you will see how devoted we are to their comfort, safety, and well-being.';
  $variables['featured_btn1_text'] = theme_get_setting('featured_btn1_text') ?: 'meet our team';
  $variables['featured_btn1_url']  = theme_get_setting('featured_btn1_url') ?: '/about-us';
  $variables['featured_btn2_text'] = theme_get_setting('featured_btn2_text') ?: 'new patients';
  $variables['featured_btn2_url']  = theme_get_setting('featured_btn2_url') ?: '/first-visit';

  // ── Office Tour Section ──────────────────────────────────────────────────
  $variables['office_tour_heading']  = theme_get_setting('office_tour_heading') ?: 'Office Tour';
  $variables['office_tour_cta_text'] = theme_get_setting('office_tour_cta_text') ?: 'view our photo gallery';
  $variables['office_tour_cta_url']  = theme_get_setting('office_tour_cta_url') ?: '/gallery';

  $slide_defaults = [
    1 => ['image' => $theme_path . '/assets/imgs/slider-1.jpg', 'alt' => 'Reception area of Staten Island Pediatric Dentistry'],
    2 => ['image' => $theme_path . '/assets/imgs/slider-2.jpg', 'alt' => 'Waiting area of Staten Island Pediatric Dentistry'],
    3 => ['image' => $theme_path . '/assets/imgs/slider-3.jpg', 'alt' => 'Treatment room at Staten Island Pediatric Dentistry'],
  ];
  for ($i = 1; $i <= 3; $i++) {
    $variables["office_tour_slide_{$i}_image"] = theme_get_setting("office_tour_slide_{$i}_image") ?: $slide_defaults[$i]['image'];
    $variables["office_tour_slide_{$i}_alt"]   = theme_get_setting("office_tour_slide_{$i}_alt") ?: $slide_defaults[$i]['alt'];
  }

  // ── Testimonials Section ─────────────────────────────────────────────────
  $variables['testimonials_heading']  = theme_get_setting('testimonials_heading') ?: 'What Our Patients Say About Us';
  $variables['testimonials_cta_text'] = theme_get_setting('testimonials_cta_text') ?: 'read our testimonials';
  $variables['testimonials_cta_url']  = theme_get_setting('testimonials_cta_url') ?: '/testimonials';

  $splide_config = json_encode([
    'width'    => theme_get_setting('testimonials_splide_width') ?: '60vw',
    'interval' => (int) (theme_get_setting('testimonials_splide_interval') ?: 15000),
  ]);
  $variables['testimonials_splide_config'] = $splide_config;

  $testimonial_defaults = [
    1 => '"My children have always had a positive experience with Dr. Michelle and her staff. Everyone you encounter in the office is friendly and helpful. Dr. Michelle does everything she can to make children feel comfortable and takes time to explain procedures to them in ways they can understand. She also took time with me to explain the best options when I had to make a decision about how to handle my kids\' dental situations. I am very happy with their services and I highly recommend them!"',
    2 => '"Every so often you meet someone who has quite simply found their perfect niche in this crazy world. Dr. Michelle is one of those people. She is the best at what she does. My 3 year old is excited to visit the dentist. Michelle makes him feel valued and special and comfortable all while actually getting him to open his mouth and get his teeth cleaned! She remembers him (and me) from one visit to the next and genuinely cares about us as people not just clients. I cannot say enough complimentary things about Dr. Michelle and her practice. They are simply phenomenal and I will recommend them to anyone who will listen!"',
    3 => '"Brought my 5 year old daughter here and she absolutely loves It here!! As do i! Amazing staff! Dr Michelle is an absolute gem! My daughter had 2 cavities filled yesterday and they took such amazing care of my daughter she was so comfortable and can\'t wait to go back and that means a lot. Thank you so much for taking care of my little girl! If anyone has a child this is the place to go!"',
    4 => '"My daughter\'s first visit and it was a wonderful experience. Dr Michelle, Veronica and the staff were so thorough working and explaining everything along the way. And before I knew it, my daughter\'s loose teeth were both out. This felt like more than just a dental practice, it is an extended family taking care of my daughter. Thank you so much!!!"',
  ];
  for ($i = 1; $i <= 4; $i++) {
    $variables["testimonials_slide_{$i}_body"] = theme_get_setting("testimonials_slide_{$i}_body") ?: $testimonial_defaults[$i];
  }
}

